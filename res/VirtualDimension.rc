#pragma code_page(65001)

#include "resource.h"
#include <windows.h>
#include <commctrl.h>

#ifndef VD_VERSION_MAJOR
#define VD_VERSION_MAJOR 0
#define VD_VERSION_MINOR 95
#define VD_VERSION_PATCH 0
#endif
#define VD_STR2(x) #x
#define VD_STR(x) VD_STR2(x)
#define VD_VERSION_STRING VD_STR(VD_VERSION_MAJOR) "." VD_STR(VD_VERSION_MINOR) "." VD_STR(VD_VERSION_PATCH)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_VIRTUALDIMENSION    ICON                    "VirtualDimension.ico"
IDI_DEFAPP_SMALL        ICON                    "defaultapp_sm.ico"
IDI_KILL                ICON                    "kill.ico"
IDI_MAXIMIZE_VERT       ICON                    "maxV.ico"
IDI_MAXIMIZE_HORIZ      ICON                    "maxH.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Logo (displayed in the about box)
//

IDR_LOGO                300                     "logo.gif"

/////////////////////////////////////////////////////////////////////////////
//
// Manifest
//

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST   "VirtualDimension.exe.manifest"

/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_VIRTUALDIMENSION ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_VIRTUALDIMENSION MENU
BEGIN
    POPUP "Popupmenu"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
        MENUITEM "&Configure...",               IDM_CONFIGURE
        MENUITEM "E&xit",                       IDM_EXIT
    END
END

IDM_WALLPAPER_CTXMENU MENU
BEGIN
    POPUP "PopupMenu"
    BEGIN
        MENUITEM "&Default wallpaper",          IDC_DEFAULT_WALLPAPER
        MENUITEM "&No wallpaper",               IDC_NO_WALLPAPER
        MENUITEM SEPARATOR
        MENUITEM "&Reset",                      IDC_PREVIOUS_WALLPAPER
        MENUITEM SEPARATOR
        MENUITEM "&Browse...",                  IDC_BROWSE_WALLPAPER
    END
END

IDM_SHORTCUTS_CTXMENU MENU
BEGIN
    POPUP "Menu"
    BEGIN
        MENUITEM "&Clear",                      IDC_CLEAR_SHORTCUT
        MENUITEM "&Reset",                      IDC_RESET_SHORTCUT
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 22, 17, 325, 92
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP |
    WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_MYICON,"Static",SS_OWNERDRAW,5,6,112,80
    LTEXT           "Virtual Dimension",IDC_PRODUCT,123,7,142,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2003-2008 Francois Ferrand",IDC_COPYRIGHT,
                    123,17,142,8
    CONTROL         "http://virt-dimension.sourceforge.net",
                    IDC_HOMEPAGE_LINK,"HyperLinkControl",WS_GROUP |
                    WS_TABSTOP,123,30,122,8,WS_EX_TRANSPARENT
    LTEXT           "Virtual Dimension comes with ABSOLUTELY NO WARRANTY. This is free software, and you are welcome to redistribute it under certain conditions. See the GNU General Public License for details.",
                    IDC_STATIC,123,44,196,32,SS_NOPREFIX
    CONTROL         "Click here to display the GNU General Public License",
                    IDC_GPL_LINK,"HyperLinkControl",WS_GROUP | WS_TABSTOP,
                    123,78,196,8,WS_EX_TRANSPARENT
    DEFPUSHBUTTON   "OK",IDOK,272,6,47,13,WS_GROUP
END

IDD_DESKS_SETTINGS DIALOGEX 22, 17, 212, 114
STYLE DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | DS_FIXEDSYS |
    DS_CONTROL | DS_CENTER | WS_CHILD | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Desktops"
FONT 9, "Segoe UI", 400, 0, 0x1
