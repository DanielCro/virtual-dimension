/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VD_VERSION_MAJOR,VD_VERSION_MINOR,VD_VERSION_PATCH,0
 PRODUCTVERSION VD_VERSION_MAJOR,VD_VERSION_MINOR,VD_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "A free, fast, and feature-full virtual desktop manager for Windows."
            VALUE "FileDescription", "Virtual Dimension"
            VALUE "FileVersion", VD_VERSION_STRING
            VALUE "InternalName", "Virtual Dimension"
            VALUE "LegalCopyright", "Copyright (C) 2003-2008 François Ferrand"
            VALUE "OriginalFilename", "VirtualDimension.exe"
            VALUE "ProductName", "Virtual Dimension"
            VALUE "ProductVersion", VD_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

